CREATORMIND_ENVIRONMENT=development
CREATORMIND_DEBUG=true
CREATORMIND_API_V1_PREFIX=/api/v1
CREATORMIND_CORS_ORIGINS=http://localhost:5173

CREATORMIND_DATABASE_URL=postgresql+asyncpg://creatormind:creatormind_dev@localhost:5433/creatormind
CREATORMIND_REDIS_URL=redis://localhost:6382/0
CREATORMIND_CELERY_BROKER_URL=redis://localhost:6382/1
CREATORMIND_CELERY_RESULT_BACKEND=redis://localhost:6382/2

CREATORMIND_S3_ENDPOINT_URL=http://localhost:19000
CREATORMIND_S3_ACCESS_KEY=creatormind
CREATORMIND_S3_SECRET_KEY=creatormind_dev_secret
CREATORMIND_S3_BUCKET=creatormind
CREATORMIND_SOURCE_MAX_BYTES=10485760
CREATORMIND_SOURCE_MAX_CHARS=500000
CREATORMIND_SOURCE_MAX_CHUNKS=600
CREATORMIND_IMAGE_MAX_PIXELS=20000000

CREATORMIND_LLM_PROVIDER=openai-compatible
CREATORMIND_LLM_BASE_URL=http://localhost:11434/v1
CREATORMIND_LLM_MODEL=qwen3
CREATORMIND_LLM_API_KEY=
CREATORMIND_EMBEDDING_BASE_URL=http://localhost:11434/v1
CREATORMIND_EMBEDDING_MODEL=nomic-embed-text
CREATORMIND_EMBEDDING_API_KEY=
CREATORMIND_EMBEDDING_DIMENSIONS=768
CREATORMIND_VISION_BASE_URL=http://localhost:11434/v1
CREATORMIND_VISION_MODEL=
CREATORMIND_VISION_API_KEY=
CREATORMIND_RETRIEVAL_MIN_SIMILARITY=0.25
